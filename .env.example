DATABASE_URL=postgresql://postgres:postgres@localhost:5433/talentos
APP_ENV=development
LOG_LEVEL=INFO
SUPABASE_FUNCTIONS_BASE_URL=https://your-project.supabase.co/functions/v1
RESEND_API_KEY=

# Supabase webhook (set same value in Supabase Database Webhook header)
SUPABASE_WEBHOOK_SECRET=
# Only if resume Storage bucket is private
SUPABASE_SERVICE_ROLE_KEY=

# Kafka / Redpanda (host: localhost:9092 | inside docker-compose: redpanda:29092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVALUATION=resume.evaluation.queue
KAFKA_TOPIC_EVALUATION_DLQ=resume.evaluation.dlq
KAFKA_CONSUMER_GROUP=resume-evaluators
KAFKA_EVALUATION_PARTITIONS=6

# talentOS_AI evaluate-resume service
AI_SERVICE_BASE_URL=http://localhost:8080
AI_SERVICE_TIMEOUT=60

# Resume evaluation
ATS_THRESHOLD_DEFAULT=70
EVALUATION_MAX_ATTEMPTS=3
EVALUATION_MIN_RESUME_CHARS=100

# Google OAuth (user login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar (service account — separate from OAuth login)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATION_EMAIL=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:5173

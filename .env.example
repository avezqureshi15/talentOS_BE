# App
APP_NAME=TalentOS
DEBUG=false
FRONTEND_URL=http://localhost:3000

# PostgreSQL (TalentOS database)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/talentos

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Webtrack (read-only PostgreSQL — fill when schema confirmed)
WEBTRACK_DATABASE_URL=postgresql+asyncpg://user:pass@webtrack-host:5432/webtrack

# Careers Page (Supabase — fill when schema confirmed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

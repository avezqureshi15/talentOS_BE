# Optional — only for host-side alembic/uvicorn. With docker compose, API is on :8001.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/talentos
# Environment: development | uat | production
# development/uat/staging -> dev timings (reminder ~10s, escalation ~20s, 3s cron)
# production -> prod timings (reminder 2h, escalation 3h, hourly cron)
APP_ENV=development
LOG_LEVEL=INFO
# Log timestamps timezone (IANA name). DB timestamps & API payloads stay UTC.
# Optional — container TZ env already sets IST on the server.
LOG_TIMEZONE=Asia/Kolkata
SUPABASE_FUNCTIONS_BASE_URL=https://your-project.supabase.co/functions/v1
RESEND_API_KEY=

SUPABASE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVALUATION=resume.evaluation.queue
KAFKA_TOPIC_EVALUATION_DLQ=resume.evaluation.dlq
KAFKA_CONSUMER_GROUP=resume-evaluators
KAFKA_EVALUATION_PARTITIONS=6

# Service-to-service auth
JWKS_URL_AI_RECRUITMENT_POC=http://localhost:8080/.well-known/jwks.json

AI_SERVICE_BASE_URL=http://localhost:8080
AI_SERVICE_TIMEOUT=60

# ai-recruitment-poc (RH) integration
RH_SERVICE_URL=http://localhost:8080
RH_SERVICE_PRIVATE_KEY_PATH=
RH_API_KEY=

ATS_THRESHOLD_DEFAULT=70
EVALUATION_MAX_ATTEMPTS=3
EVALUATION_MIN_RESUME_CHARS=100

# CORS — comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173

# Google OAuth (user login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar (service account — separate from OAuth login)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATION_EMAIL=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# Form timing
FORM_REMINDER_HOURS=2
FORM_ESCALATION_HOURS=3
FORM_EXPIRY_HOURS=24

# MeetMind — schedule meetings + receive signed transcript webhooks
MEETMIND_BASE_URL=https://meet.webknot.in
MEETMIND_API_TOKEN=  # sent as X-API-Key on schedule
MEETMIND_WEBHOOK_SECRET=
MEETMIND_EXTERNAL=talentos.ai
INTERVIEW_FALLBACK_SECONDS=60

# Data-encryption key for tenant-managed API secrets (Fernet).
# Blank = falls back to JWT_SECRET.
SECRETS_ENCRYPTION_KEY=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:5173
